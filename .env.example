# Copy this file to .env (which is gitignored) and paste your keys after the =.
# Get an Anthropic key at https://console.anthropic.com
# Get an OpenRouter key at https://openrouter.ai/keys
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Asymmetry Bench storage (defaults shown; both paths are gitignored)
ASYMBENCH_DB=data/asymbench.db
ASYMBENCH_RUNS_DIR=runs
