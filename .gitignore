.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
*.egg-info/
.pytest_cache/

# New experiment outputs are local artifacts; existing tracked logs stay tracked.
results/

# Secrets (API keys). Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Asymmetry Bench runtime artifacts (created by `python -m asymbench`).
# Exported run folders (runs/run_*/) ARE tracked: committing one and listing
# its id in runs/manifest.txt publishes it to the team site (runs/README.md).
runs/*
!runs/manifest.txt
!runs/README.md
!runs/run_*/
data/

# Personal Claude Code permission overrides
.claude/settings.local.json
